# Smash Notebook Domain Rules

## Type Definitions
- PercentBand = '0-30' | '40-70' | '80+' | 'Kill%'
- Situation = 'neutral' | 'ledgetrap' | 'edgeguard' | 'recovery' | 'combo' | 'line'
- Character = '00' | '01' | '02' | ... | '82' (マリオ〜ソラまで)
- Section = '立ち回り' | '崖展開' | '崖狩り' | '復帰阻止' | 'ライン回復' | '崖上がり' | '復帰'

## Card Structure
Card = {
  id: string
  myChar: Character
  oppChar: Character
  percentBand: PercentBand
  situation: Situation
  oppMove?: string
  answerMD: string
  section: Section
  tags: string[]
}

## Deck Structure
Deck = {
  id: string
  title: string
  description?: string
  myCharacter: Character
  cards: Card[]
  isTemplate: boolean
  isPublic: boolean
  tags: string[]
  likes: number
  uses: number
}

